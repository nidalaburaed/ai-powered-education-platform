# Text-to-speech
# Free default: Piper local TTS, with eSpeak NG as a no-cost fallback.
TTS_PROVIDER=piper
TTS_FALLBACK_PROVIDER=espeak
TTS_CACHE_DIR=/tmp/ai-edu/tts-cache

# Piper (free/local). Download .onnx voice models and point these at them.
PIPER_BINARY=piper
PIPER_TEACHER_MODEL=/models/piper/en_US-lessac-medium.onnx
PIPER_STUDENT_MODEL=/models/piper/en_US-ryan-medium.onnx

# eSpeak NG (free/local fallback; installed in the Docker image).
ESPEAK_BINARY=espeak-ng
ESPEAK_TEACHER_VOICE=en-us+m3
ESPEAK_STUDENT_VOICE=en-us+f3

# ElevenLabs (optional premium provider; only required when TTS_PROVIDER=elevenlabs).
